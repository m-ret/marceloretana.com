{
  "kind": "singleType",
  "collectionName": "profiles",
  "info": {
    "singularName": "profile",
    "pluralName": "profiles",
    "displayName": "Profile",
    "description": "Personal profile information"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "tagline": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "profileImage": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "linkedinUrl": {
      "type": "string"
    },
    "skills": {
      "type": "json"
    }
  }
}
